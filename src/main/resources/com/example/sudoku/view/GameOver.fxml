<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox alignment="CENTER" prefHeight="500" prefWidth="650" spacing="20" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sudoku.controller.GameOverController">
   <padding>
      <Insets top="20.0" />
   </padding>
   <children>
      <Label fx:id="messageLabel" styleClass="title" text="¡Felicidades, lograste superar el sudoku!" textAlignment="CENTER" wrapText="true" />
      <Button fx:id="newGameButton" mnemonicParsing="false" onAction="#restartGame" styleClass="button" text="Nuevo juego" />
   </children>
</VBox>
