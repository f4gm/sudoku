<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500" prefWidth="650" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sudoku.controller.GameController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onNewGame" styleClass="button" text="Nuevo juego" />
            <Button fx:id="helpButton" mnemonicParsing="false" onAction="#onHelp" styleClass="button" text="Ayuda (3)" />
         </children>
      </HBox>
      <GridPane fx:id="sudokuGrid" alignment="CENTER" />
      <Label fx:id="statusLabel" styleClass="state" text="Pulsa &quot;Nuevo juego&quot; para empezar" textAlignment="CENTER" wrapText="true" />
   </children>
</VBox>
